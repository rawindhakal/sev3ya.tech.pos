// CakeZake POS — database schema
// Provider: PostgreSQL. ORM: Prisma.
// This schema models the full POS domain. In this first pass the API + UI
// fully implement Categories, MenuItems and Modifiers; the remaining models
// (Tables, Orders, KOT, Payments) are defined here so features can be added
// incrementally without breaking migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// MENU
// ─────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Default OS printer name for every item in this category's tickets —
  // null means "use this till's per-station KOT/BOT printer" (Settings →
  // Printing), same as today. A MenuItem.printerName override beats this.
  printerName String?

  @@map("categories")
}

model MenuItem {
  id                 String      @id @default(cuid())
  name               String
  description        String?
  // Price stored in minor units (cents) to avoid floating point errors.
  // priceCents is the base (dine-in) price; the tier prices below are
  // optional overrides used for takeaway / delivery (matrix #15).
  priceCents         Int
  takeawayPriceCents Int?
  deliveryPriceCents Int?
  // Which prep station this item routes to (KOT/BOT/Billing) (user workflow).
  station            PrepStation @default(BILLING)
  isAvailable        Boolean     @default(true)
  imageUrl           String?

  // Overrides both the station default AND Category.printerName — e.g. two
  // kitchen printers (K1/K2), route this one dish to K1 specifically. Null
  // falls back to Category.printerName, then the till's station default.
  printerName String?

  // Combo/meal-deal: this item is sold as a single line (one price, one KOT
  // entry) but bundles other menu items — see ComboComponent. Inventory
  // deduction expands a combo into its components' recipes at sale time.
  isCombo         Boolean          @default(false)
  comboComponents ComboComponent[] @relation("ComboOwner")
  usedInCombos    ComboComponent[] @relation("ComboComponentItem")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Modifier groups attached to this item (e.g. "Size", "Add-ons").
  modifierGroups ModifierGroup[] @relation("MenuItemModifierGroups")

  orderItems OrderItem[]
  recipe     RecipeItem[] // BOM: ingredients this item consumes (matrix #57)
  variants   MenuItemVariant[] // portions e.g. Whiskey 30ml / 60ml

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("menu_items")
}

// A component menu item that makes up a combo (MenuItem.isCombo = true).
// e.g. Combo "Burger Meal" -> [Burger x1, Fries x1, Coke x1].
model ComboComponent {
  id                  String   @id @default(cuid())
  comboMenuItemId     String
  comboMenuItem       MenuItem @relation("ComboOwner", fields: [comboMenuItemId], references: [id], onDelete: Cascade)
  componentMenuItemId String
  componentMenuItem   MenuItem @relation("ComboComponentItem", fields: [componentMenuItemId], references: [id])
  quantity            Int      @default(1)

  @@index([comboMenuItemId])
  @@map("combo_components")
}

// A priced portion/variant of a menu item (replaces the base price when chosen).
model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String // e.g. "30ml", "Large"
  priceCents Int
  sortOrder  Int      @default(0)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model ModifierGroup {
  id        String     @id @default(cuid())
  name      String // e.g. "Size", "Extra toppings"
  // Selection rules: how many options a customer may pick.
  minSelect Int        @default(0)
  maxSelect Int        @default(1)
  sortOrder Int        @default(0)
  modifiers Modifier[]
  menuItems MenuItem[] @relation("MenuItemModifierGroups")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("modifier_groups")
}

model Modifier {
  id         String        @id @default(cuid())
  name       String // e.g. "Large", "Extra cheese"
  priceCents Int           @default(0) // price delta this modifier adds
  sortOrder  Int           @default(0)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([groupId])
  @@map("modifiers")
}

// ─────────────────────────────────────────────────────────────
// FLOOR / TABLES
// ─────────────────────────────────────────────────────────────

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model RestaurantTable {
  id           String        @id @default(cuid())
  name         String // e.g. "T1", "Patio 3"
  seats        Int           @default(4)
  area         String? // e.g. "Ground floor", "Patio"
  // Which physical location this table belongs to (multi-outlet, Phase 3) —
  // a table can't move between locations.
  outletId     String
  outlet       Outlet        @relation(fields: [outletId], references: [id])
  status       TableStatus   @default(AVAILABLE)
  isVip        Boolean       @default(false) // VIP / regulars highlighting (#39)
  // Soft-delete — a table with order/reservation history can't be hard-deleted
  // (Order.tableId/Reservation.tableId aren't cascading), so "delete" on a
  // used table just hides it from normal lists instead.
  isActive     Boolean       @default(true)
  // Floor-plan canvas position within its area (matrix #26).
  posX         Int?
  posY         Int?
  // Public QR-ordering token — printed on a table QR code, resolves to this
  // table with no login required (apps/web/app/order/[token]). Generated
  // on-demand (Tables → "Get QR"), not backfilled — null = QR not set up yet.
  qrToken      String?       @unique
  orders       Order[]
  reservations Reservation[]
  waiterCalls  WaiterCall[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("restaurant_tables")
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

// "Call waiter" button on the QR self-order page — software equivalent of a
// table buzzer. Surfaced to staff on the waiter/POS screens.
model WaiterCall {
  id         String           @id @default(cuid())
  tableId    String
  table      RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status     WaiterCallStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("waiter_calls")
}

// ─────────────────────────────────────────────────────────────
// RESERVATIONS & WAITLIST (matrix #30)
// ─────────────────────────────────────────────────────────────

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id           String            @id @default(cuid())
  customerName String
  phone        String?
  partySize    Int               @default(2)
  reservedAt   DateTime // requested date/time (≈ now for waitlist)
  isWaitlist   Boolean           @default(false) // walk-in queue vs advance booking
  status       ReservationStatus @default(BOOKED)
  notes        String?

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservedAt])
  @@index([status])
  @@map("reservations")
}

// ─────────────────────────────────────────────────────────────
// ORDERS / KOT / BILLING
// ─────────────────────────────────────────────────────────────

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderSource {
  STAFF
  SELF_ORDER
}

// Post-order guest feedback (rating + optional comment), collected via a
// link/QR shown after the bill on the self-order page.
model OrderFeedback {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@map("order_feedback")
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  READY
  SERVED
  BILLED
  PAID
  REFUNDED
  CANCELLED
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

// Prep station an item routes to: kitchen (KOT), bar (BOT), or bill-only.
enum PrepStation {
  KITCHEN
  BAR
  BILLING
}

model Order {
  id     String      @id @default(cuid())
  // Human-friendly running order number.
  number Int         @default(autoincrement())
  type   OrderType   @default(DINE_IN)
  status OrderStatus @default(OPEN)

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  // Which physical location rang this order (multi-outlet, Phase 3).
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  waiterId String?
  waiter   Waiter? @relation(fields: [waiterId], references: [id])

  // Dine-in guest count (covers) — used for guest-time / per-cover analytics.
  guestCount Int @default(1)

  // Customer capture for takeaway / delivery (design spec §2.1 Step 2).
  customerName  String?
  customerPhone String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  items    OrderItem[]
  payments Payment[]

  // Denormalised money snapshots (minor units).
  subtotalCents        Int @default(0)
  discountCents        Int @default(0)
  serviceChargeCents   Int @default(0)
  packagingChargeCents Int @default(0) // flat charge, TAKEAWAY/DELIVERY
  deliveryChargeCents  Int @default(0) // flat charge, DELIVERY only
  taxCents             Int @default(0)
  totalCents           Int @default(0)

  // Where this order originated — a self-order (QR) came in with no staff
  // member present, which some UI/permission flows care about.
  source OrderSource @default(STAFF)

  feedback             OrderFeedback?
  giftCardTransactions GiftCardTransaction[]
  couponRedemption     CouponRedemption?

  notes String?

  // Loyalty points redeemed against this order (#111).
  redeemedPoints Int @default(0)

  // Nepali fiscal year (e.g. "2082/83") + IRD-compliant invoice number that
  // resets each fiscal year — both stamped at payment time.
  fiscalYear      String?
  fiscalInvoiceNo Int?

  // IRD (CBMS) e-billing sync state for this invoice.
  irdSyncedAt    DateTime?
  irdSyncStatus  String? // SYNCED | FAILED
  irdSyncMessage String?

  // Which terminal/till rang this order (multi-terminal attribution). Always
  // null before Phase 3 (never wired up in the frontend until now) — safe to
  // convert straight to a real relation with no data to migrate.
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  // Void / refund audit trail (matrix #10).
  voidReason   String?
  refundReason String?
  refundCents  Int       @default(0)
  refundedAt   DateTime?

  // Discount provenance — which named preset (Settings → Discounts) or
  // "Custom" was applied, and whether the whole bill was comped to zero.
  discountLabel      String?
  isComplimentary    Boolean @default(false)
  // Who approved a non-zero discount (staff name at the time it was set) —
  // feeds the Discounts & Complimentary report. Complimentary bills use
  // AuditLog (action=COMPLIMENTARY) for their own authorizer instead.
  discountApprovedBy String?

  // Name of the staff member signed in when this order was settled — printed
  // on the bill as "Cashier: ..." and kept even if that employee is later
  // renamed/removed, since it's a point-in-time snapshot like nameSnapshot.
  cashierName String?

  // How many times this bill has been reprinted from Sales Reports (the
  // original checkout print never touches this) — each reprint gets a
  // numbered "COPY #n" watermark so it's never confused with the original.
  reprintCount Int @default(0)

  // Lifecycle timestamps drive turnaround / guest-time metrics.
  seatedAt   DateTime? // when the table became occupied for this order
  kotFiredAt DateTime? // when the KOT was first sent to the kitchen (KDS timer)
  billedAt   DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@index([fiscalYear])
  @@map("orders")
}

model Waiter {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waiters")
}

// ─────────────────────────────────────────────────────────────
// EMPLOYEES, ROLES & SHIFTS (matrix #126–140, spec §2.1/§3.1 Step 3)
// ─────────────────────────────────────────────────────────────

// Whether an employee assigned this role lands in the full back-office UI or
// is locked to the bare Waiter Panel — replaces the old `role === 'WAITER'`
// string check now that roles are custom/dynamic (see PermissionGuard).
enum RolePortal {
  BACK_OFFICE
  WAITER_ONLY
}

// Custom, tenant-defined role — replaces the fixed StaffRole enum + 5 boolean
// flags on Employee. Exactly one `isProtected` role ("Owner") is seeded per
// database and always holds every permission in PERMISSIONS
// (apps/api/src/common/permissions.ts) — it can never be edited or deleted,
// guaranteeing there's always at least one account that can manage roles.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  portal      RolePortal       @default(BACK_OFFICE)
  isProtected Boolean          @default(false)
  permissions RolePermission[]
  employees   Employee[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// One granted permission key per row. `key` is validated against the fixed
// PERMISSIONS catalog in application code, not the database — adding a new
// permission key is a code change, never a migration.
model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
  @@index([roleId])
  @@map("role_permissions")
}

model Employee {
  id                 String           @id @default(cuid())
  name               String
  roleId             String
  role               Role             @relation(fields: [roleId], references: [id])
  username           String?          @unique // username + password login
  passwordHash       String? // scrypt salt:hash
  isActive           Boolean          @default(true)
  // ZKTeco fingerprint device user ID (maps scans → this employee).
  deviceUserId       String?          @unique
  // Payroll: fixed monthly salary in paisa (pro-rated by attendance).
  monthlySalaryCents Int              @default(0)
  attendance         AttendanceLog[]
  outlets            EmployeeOutlet[]

  // ── HRM profile (Phase 4) — all optional, filled in over time by HR ──
  dateOfBirth           DateTime?
  joinDate              DateTime?
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankName              String?
  bankAccountNumber     String?
  panNumber             String?
  employmentType        String? // FULL_TIME | PART_TIME | CONTRACT | INTERN
  designation           String? // free-text job title — distinct from Role (a permission set)

  documents          EmployeeDocument[]
  performanceNotes   PerformanceNote[]
  leaveRequests      LeaveRequest[]
  rosterEntries      RosterEntry[]
  payrollAdjustments PayrollAdjustment[]

  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model Shift {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn    DateTime  @default(now())
  clockOut   DateTime?

  @@index([employeeId])
  @@map("shifts")
}

// ─────────────────────────────────────────────────────────────
// CRM & LOYALTY (matrix #111–125)
// ─────────────────────────────────────────────────────────────

model Customer {
  id                 String              @id @default(cuid())
  name               String
  phone              String              @unique
  email              String?
  birthday           DateTime?
  loyaltyPoints      Int                 @default(0)
  totalSpentCents    Int                 @default(0)
  // Membership number (e.g. RADH1 — initials + sequence), PAN for businesses.
  memberCode         String?             @unique
  panNumber          String?
  isBusiness         Boolean             @default(false)
  // Outstanding credit the customer owes (CREDIT tender / house account).
  creditBalanceCents Int                 @default(0)
  visitCount         Int                 @default(0)
  lastVisitAt        DateTime?
  optIn              Boolean             @default(true) // marketing opt-in (#125 GDPR)
  orders             Order[]
  creditLedger       CreditLedgerEntry[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("customers")
}

enum CreditEntryType {
  CHARGE // sale put on the customer's account (CREDIT tender)
  PAYMENT // customer paid down their balance
}

// Full ledger for the customer credit facility (house accounts). Every CREDIT
// sale writes a CHARGE, every settlement writes a PAYMENT with the tender used,
// and balanceAfterCents snapshots the running balance for a printable ledger.
model CreditLedgerEntry {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type              CreditEntryType
  amountCents       Int
  method            PaymentMethod? // how a PAYMENT was received (CASH shows in drawer)
  orderId           String? // the sale behind a CHARGE
  note              String?
  balanceAfterCents Int
  createdBy         String?
  createdAt         DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("credit_ledger_entries")
}

// ─────────────────────────────────────────────────────────────
// FINANCIAL ACCOUNTING & EXPENSES (matrix #156–170)
// ─────────────────────────────────────────────────────────────

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  MARKETING
  MAINTENANCE
  SUPPLIES
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory @default(OTHER)
  amountCents Int
  description String?
  // How it was paid — used to post the Cr side (Cash vs Bank & Wallets) when
  // this expense is posted to the GL. Previously unrecorded; the old ledger
  // live-merge silently assumed every expense was a cash outflow.
  method      PaymentMethod   @default(CASH)
  incurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([incurredAt])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────
// SPECIALTY COFFEE & ROASTERY (matrix #81–95)
// ─────────────────────────────────────────────────────────────

model GreenBeanBatch {
  id             String         @id @default(cuid())
  name           String // e.g. "Nepal Everest AA"
  origin         String?
  estate         String?
  process        String? // Washed / Natural / Honey
  moisturePct    Float?
  weightKg       Float // received green weight
  remainingKg    Float // remaining un-roasted
  costPerKgCents Int            @default(0)
  purchasedAt    DateTime       @default(now())
  roasts         RoastBatch[]
  cuppings       CuppingScore[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("green_bean_batches")
}

model RoastBatch {
  id              String         @id @default(cuid())
  number          Int            @default(autoincrement())
  greenBatchId    String
  greenBatch      GreenBeanBatch @relation(fields: [greenBatchId], references: [id], onDelete: Cascade)
  greenInputKg    Float
  roastedOutputKg Float
  shrinkagePct    Float // auto-computed (#83)
  chargeTempC     Float?
  dropTempC       Float?
  devTimeSec      Int?
  agtron          Int? // roast colour (#93)
  notes           String?
  roastedAt       DateTime       @default(now())

  @@map("roast_batches")
}

model CuppingScore {
  id           String         @id @default(cuid())
  greenBatchId String
  greenBatch   GreenBeanBatch @relation(fields: [greenBatchId], references: [id], onDelete: Cascade)
  aroma        Float
  flavor       Float
  acidity      Float
  body         Float
  balance      Float
  total        Float // sum of the five (out of 50)
  notes        String?
  createdAt    DateTime       @default(now())

  @@map("cupping_scores")
}

// Immutable audit trail of sensitive actions (matrix #155/#08, spec §3.1).
model AuditLog {
  id           String   @id @default(cuid())
  employeeId   String?
  employeeName String
  action       String // VOID, REFUND, LOGIN, …
  detail       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable so "open items" (custom name/price, not on the menu) are
  // supported (matrix #16).
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  // Snapshot of name/price at time of ordering.
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int    @default(1)

  // Selected modifiers stored as JSON snapshot: [{name, priceCents}]
  modifiers     Json?
  kotStatus     KotStatus   @default(PENDING)
  station       PrepStation @default(BILLING) // snapshot of the item's prep station
  kotPrintedAt  DateTime? // set once a physical KOT/BOT ticket has been printed
  discountCents Int         @default(0) // item-wise discount (needs manager perm)
  notes         String?

  // Set true only when fired by a guest via the QR self-order page (never by
  // staff at POS/Waiter Panel) — keeps it out of the silent auto-print queue
  // until a waiter/cashier has reviewed and acknowledged it. Cleared back to
  // false on acknowledge, at which point it prints exactly like any other
  // fired item.
  needsGuestAck Boolean @default(false)

  // Item-level cancellation (prints a cancellation KOT + audited).
  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  String? // approving manager/admin's name, for the cancelled-items report

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}

enum PaymentMethod {
  OFFLINE
  CASH
  FONEPAY
  BANK
  ESEWA
  KHALTI
  CARD
  CREDIT
  GIFTCARD
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents Int
  method      PaymentMethod @default(CASH)
  // Set when method = GIFTCARD — which card was redeemed against.
  giftCardId  String?
  giftCard    GiftCard?     @relation(fields: [giftCardId], references: [id])
  // Set when method = ESEWA/KHALTI/FONEPAY and paid via the real gateway
  // integration (not just a manual "received via X" tag) — the provider's
  // transaction reference, for reconciliation.
  gatewayRef  String?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([method, createdAt])
  @@map("payments")
}

// ── Coupons (rule-based promo codes) ────────────────────────────────
enum CouponType {
  PCT
  RS
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  type               CouponType         @default(PCT)
  value              Int // percent (whole number) or Rs in cents, per `type`
  minOrderCents      Int                @default(0)
  maxUsesTotal       Int? // null = unlimited
  maxUsesPerCustomer Int? // null = unlimited
  usedCount          Int                @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean            @default(true)
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("coupons")
}

// One row per order a coupon was applied to — enforces usage limits and
// gives an audit trail. The actual discount amount lives on Order
// (discountCents/discountLabel, reusing the existing discount pipeline).
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  createdAt  DateTime @default(now())

  @@index([couponId])
  @@map("coupon_redemptions")
}

// ── Gift cards / store credit ───────────────────────────────────────
model GiftCard {
  id                String                @id @default(cuid())
  code              String                @unique
  initialValueCents Int
  balanceCents      Int
  isActive          Boolean               @default(true)
  issuedToName      String?
  issuedToPhone     String?
  payments          Payment[]
  transactions      GiftCardTransaction[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@map("gift_cards")
}

// Ledger of balance changes — positive = issued/topped-up, negative =
// redeemed against an order.
model GiftCardTransaction {
  id          String   @id @default(cuid())
  giftCardId  String
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

// ─────────────────────────────────────────────────────────────
// SETTINGS (editable receipt branding — matrix #11)
// ─────────────────────────────────────────────────────────────

model CafeSetting {
  // Single-row table; always addressed by id = "singleton".
  id                String  @id @default("singleton")
  restaurantName    String  @default("CakeZake")
  address           String?
  phone             String?
  taxId             String? // PAN / VAT registration number
  // Configurable tax rates (matrix #7), stored as fractions (0.13 = 13%).
  vatRate           Float   @default(0.13)
  serviceChargeRate Float   @default(0)
  // When true, menu prices already include VAT (tax is back-calculated).
  pricesIncludeVat  Boolean @default(false)
  // Dynamic preferences (Settings → Preferences).
  currencySymbol    String  @default("Rs")
  defaultGuestCount Int     @default(1)
  receiptHeader     String?
  receiptFooter     String?
  wifiPassword      String?

  // Printable ticket templates (visual editor under Settings → Printing).
  billTemplate Json?
  kotTemplate  Json?

  // IRD Nepal (CBMS e-billing) integration.
  irdEnabled   Boolean @default(false)
  irdUsername  String?
  irdPassword  String?
  irdSellerPan String?
  irdApiUrl    String? // e.g. https://cbapi.ird.gov.np/api/bill

  // Default flat packaging / delivery charges, auto-applied by order type
  // (TAKEAWAY/DELIVERY get packaging; DELIVERY also gets delivery) and
  // editable per order at checkout, same pattern as service charge.
  packagingChargeCents Int @default(0)
  deliveryChargeCents  Int @default(0)

  // Real payment-gateway merchant credentials (blank = gateway inactive —
  // POS falls back to the existing manual "record as ESEWA/KHALTI/FONEPAY"
  // flow). Filled in once the restaurant has its own merchant account.
  esewaMerchantCode   String?
  esewaSecretKey      String?
  khaltiPublicKey     String?
  khaltiSecretKey     String?
  fonepayMerchantCode String?
  fonepaySecretKey    String?

  // SMS gateway (Sparrow-SMS-style HTTP API) for order-ready / self-order
  // confirmations. Blank = SMS sending is a silent no-op.
  smsGatewayApiKey   String?
  smsGatewaySenderId String?

  // Module feature toggles — admin enables/disables sections app-wide.
  featReservations Boolean @default(true)
  featInventory    Boolean @default(true)
  featPurchasing   Boolean @default(true)
  featRoastery     Boolean @default(true)
  featModifiers    Boolean @default(true)
  featCrm          Boolean @default(true)
  featFinance      Boolean @default(true)
  featKds          Boolean @default(true)
  featSelfOrder    Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("cafe_settings")
}

// Named, reusable discounts (e.g. "Staff 10%", "Regular Rs 100") offered as
// one-tap choices in the POS discount modal instead of typing a number.
model DiscountPreset {
  id        String       @id @default(cuid())
  name      String
  type      DiscountType @default(PCT)
  value     Int // percentage (whole number) or Rs amount in cents, per `type`
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("discount_presets")
}

enum DiscountType {
  PCT
  RS
}

// ─────────────────────────────────────────────────────────────
// CASH DRAWER (petty-cash flow — matrix #17)
// ─────────────────────────────────────────────────────────────

enum CashMovementType {
  OPENING
  PAY_IN
  PAY_OUT
}

// A physical location this tenant operates (multi-outlet, Phase 3). Also
// carries optional receipt/branding overrides — null falls back to
// CafeSetting's tenant-wide default (e.g. a branch can have its own PAN/
// address on receipts without a whole parallel settings table). One is
// always auto-seeded (`isDefault: true`) per tenant so single-location
// restaurants see no UX change — see migrate-and-backfill-outlets.js.
model Outlet {
  id                String             @id @default(cuid())
  name              String
  address           String?
  phone             String?
  taxId             String? // PAN — branches can have distinct VAT registration numbers
  receiptHeader     String?
  receiptFooter     String?
  isDefault         Boolean            @default(false)
  isActive          Boolean            @default(true)
  terminals         Terminal[]
  tables            RestaurantTable[]
  orders            Order[]
  employees         EmployeeOutlet[]
  attendanceDevices AttendanceDevice[]
  shiftTemplates    ShiftTemplate[]
  rosterEntries     RosterEntry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("outlets")
}

// Restricts which outlets a non-privileged employee can select at login.
// Zero rows for an employee = unrestricted (can select any outlet) — this is
// what every existing employee has post-migration, so access doesn't change
// for anyone until an admin explicitly assigns them to specific outlets.
model EmployeeOutlet {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([employeeId, outletId])
  @@map("employee_outlets")
}

// A physical POS terminal / till (multi-terminal support).
model Terminal {
  id        String              @id @default(cuid())
  name      String
  isActive  Boolean             @default(true)
  // Which location this till belongs to.
  outletId  String
  outlet    Outlet              @relation(fields: [outletId], references: [id])
  orders    Order[]
  sessions  CashDrawerSession[]
  createdAt DateTime            @default(now())

  @@index([outletId])
  @@map("terminals")
}

model CashDrawerSession {
  id                String         @id @default(cuid())
  // Which till this session belongs to. Always null before Phase 3 (never
  // wired up in the frontend until now) — safe to convert straight to a real
  // relation with no data to migrate. Outlet is derived via terminal.outletId,
  // no separate column needed.
  terminalId        String?
  terminal          Terminal?      @relation(fields: [terminalId], references: [id])
  openedAt          DateTime       @default(now())
  openingFloatCents Int            @default(0)
  openedBy          String?
  closedAt          DateTime?
  closedBy          String?
  countedCents      Int? // physically counted cash at close
  expectedCents     Int? // system-expected cash at close
  varianceCents     Int? // counted - expected
  notes             String?
  movements         CashMovement[]

  @@map("cash_drawer_sessions")
}

model CashMovement {
  id          String            @id @default(cuid())
  sessionId   String
  session     CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amountCents Int
  reason      String?
  createdAt   DateTime          @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY & RECIPE (matrix #56–80)
// ─────────────────────────────────────────────────────────────

model Ingredient {
  id               String              @id @default(cuid())
  name             String
  unit             String              @default("g") // base stock unit: g / ml / pcs
  // Global on-hand total across all warehouses — kept in sync with the sum of
  // WarehouseStock rows below; stays authoritative for existing code that
  // doesn't care about location (recipe costing, reorder alerts, etc.).
  stockQty         Float               @default(0)
  reorderLevel     Float               @default(0) // low-stock threshold (#58)
  // Cost per base unit, in cents (paisa) — drives valuation (#75).
  costPerUnitCents Int                 @default(0)
  // Primary supplier for reordering (supplier catalog mapping, #67).
  supplierId       String?
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  recipeItems      RecipeItem[]
  movements        StockMovement[]
  poLines          PurchaseOrderLine[]
  warehouseStocks  WarehouseStock[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("ingredients")
}

// ─────────────────────────────────────────────────────────────
// WAREHOUSES / MULTI-LOCATION STOCK — additive layer on top of the
// existing global Ingredient.stockQty. A restaurant with one location can
// ignore this entirely (everything lives in the seeded "Main Store");
// multi-location operators get a per-warehouse breakdown + transfers.
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id        String           @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean          @default(true)
  isDefault Boolean          @default(false) // the auto-seeded "Main Store"; can't be deleted
  stocks    WarehouseStock[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("warehouses")
}

model WarehouseStock {
  id           String     @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty          Float      @default(0)

  @@unique([warehouseId, ingredientId])
  @@index([ingredientId])
  @@map("warehouse_stocks")
}

// ─────────────────────────────────────────────────────────────
// PURCHASING & SUPPLIERS (matrix #141–155)
// ─────────────────────────────────────────────────────────────

model Supplier {
  id          String            @id @default(cuid())
  name        String
  contact     String? // phone / email
  address     String?
  taxId       String?
  isActive    Boolean           @default(true)
  ingredients Ingredient[]
  orders      PurchaseOrder[]
  payments    SupplierPayment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("suppliers")
}

// Vendor payment ledger (owner checklist Part 3) — how much has actually
// been paid to each supplier, separate from what's been ordered/received.
// Due = received goods value (see PurchasingService.vendorLedger) − sum of
// these payments.
model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  amountCents Int
  method      String? // free-text: Cash, Bank transfer, Cheque, etc.
  note        String?
  createdAt   DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_payments")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     Int                 @default(autoincrement())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  lines      PurchaseOrderLine[]
  orderedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity      Float // ordered qty in ingredient unit
  receivedQty   Float         @default(0) // received so far (split delivery #146)
  unitCostCents Int           @default(0)

  @@map("purchase_order_lines")
}

model RecipeItem {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  // Amount of the ingredient consumed per one menu item (in ingredient.unit).
  quantity     Float

  @@unique([menuItemId, ingredientId])
  @@map("recipe_items")
}

enum StockMovementType {
  PURCHASE
  SALE_DEDUCTION
  WASTAGE
  STOCK_TAKE
  ADJUSTMENT
  TRANSFER
}

model StockMovement {
  id            String            @id @default(cuid())
  ingredientId  String
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantity      Float // signed delta in base unit (− for consumption)
  reason        String?
  // Which warehouse this movement applies to (null = legacy/global-only
  // movement predating this feature). For TRANSFER, warehouseId is the
  // source (its delta is negative) and toWarehouseId is the destination.
  warehouseId   String?
  toWarehouseId String?
  createdAt     DateTime          @default(now())

  @@index([ingredientId])
  @@index([warehouseId])
  @@map("stock_movements")
}

// Idempotency store — lets the offline outbox safely replay a queued mutation
// without creating duplicates. The client sends a stable Idempotency-Key header;
// the first execution's response is cached and returned verbatim on any replay.
model IdempotencyKey {
  key        String   @id
  method     String
  path       String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}

// A write the offline outbox eventually delivered to the server, but which
// the server genuinely rejected (not a connectivity blip) — e.g. an invalid
// gift-card code discovered only at sync time, or a client-id collision on
// order create. Surfaced in the back-office Sync Recovery view so a manager
// can manually re-enter or reconcile it; never retried automatically (a
// rejected write usually needs a human decision, not another attempt).
model FailedSyncItem {
  id             String    @id @default(cuid())
  orderId        String?
  method         String
  path           String
  body           Json?
  idempotencyKey String    @unique
  errorMessage   String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([orderId])
  @@index([acknowledgedAt])
  @@map("failed_sync_items")
}

// ─────────────────────────────────────────────────────────────
// DOUBLE-ENTRY ACCOUNTING — real GL posting + approval workflows
// ─────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Chart of accounts. System accounts are seeded and undeletable.
model LedgerAccount {
  id        String        @id @default(cuid())
  code      String        @unique // e.g. "1000"
  name      String
  type      AccountType
  group     String? // e.g. "Current Assets", "Indirect Expenses"
  isSystem  Boolean       @default(false)
  isActive  Boolean       @default(true)
  lines     JournalLine[]
  createdAt DateTime      @default(now())

  @@map("ledger_accounts")
}

// POSTED = affects balances. PENDING_APPROVAL = real rows, excluded from every
// balance/ledger/trial-balance query until approved. REJECTED = terminal, also
// excluded, kept for audit trail.
enum JournalStatus {
  POSTED
  PENDING_APPROVAL
  REJECTED
}

// A journal voucher — either hand-entered (source: MANUAL) or auto-posted by
// the business-transaction hooks in orders/purchasing/crm/finance services
// (source: ORDER_SALE | PURCHASE_RECEIPT | SUPPLIER_PAYMENT |
// CREDIT_SETTLEMENT | EXPENSE). Lines must balance (Dr total = Cr total),
// enforced in PostingService, not the DB. `sourceId` traces back to the
// originating Order/PurchaseOrder/Supplier/Customer/Expense id — this is how
// a supplier/customer's ledger ties into the GL without needing one
// LedgerAccount per party (the standard control-account pattern; Supplier/
// Customer + their own subsidiary ledgers stay the detail records).
model JournalEntry {
  id             String                 @id @default(cuid())
  number         Int                    @default(autoincrement())
  type           String                 @default("JOURNAL")
  date           DateTime               @default(now())
  narration      String?
  createdBy      String?
  status         JournalStatus          @default(POSTED)
  source         String                 @default("MANUAL")
  sourceId       String?
  // Denormalized from the source transaction at posting time (multi-outlet,
  // Phase 3) — a filter/reporting dimension only. The chart of accounts,
  // ledger and trial balance stay one consolidated tenant-wide book; this is
  // not a per-outlet ledger partition.
  outletId       String?
  workflowRuleId String?
  workflowRule   JournalWorkflowRule?   @relation(fields: [workflowRuleId], references: [id])
  currentStep    Int?
  approvals      JournalEntryApproval[]
  lines          JournalLine[]
  createdAt      DateTime               @default(now())

  @@index([date])
  @@index([status])
  @@index([source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  drCents   Int           @default(0)
  crCents   Int           @default(0)

  @@index([accountId])
  @@map("journal_lines")
}

// Configurable approval rule — "every journal must match a published
// workflow" (only true once at least one rule is configured; with zero rules,
// everything posts immediately, matching today's behavior — see
// PostingService). `journalEvent` is one of JournalEntry.source's values, or
// "ANY". The highest-priority active rule whose event + amount range matches
// wins; `postAutomatically` skips the approval steps entirely.
model JournalWorkflowRule {
  id                  String                @id @default(cuid())
  code                String                @unique
  name                String
  journalEvent        String
  minAmountCents      Int?
  maxAmountCents      Int?
  priority            Int                   @default(100)
  postAutomatically   Boolean               @default(false)
  // Stored for a future notification phase — not wired to delivery yet.
  firstReminderHours  Int?
  repeatReminderHours Int?
  isActive            Boolean               @default(true)
  steps               JournalApprovalStep[]
  entries             JournalEntry[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([journalEvent, isActive])
  @@map("journal_workflow_rules")
}

model JournalApprovalStep {
  id                String              @id @default(cuid())
  ruleId            String
  rule              JournalWorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  stepOrder         Int
  name              String
  approvalsRequired Int                 @default(1)

  @@unique([ruleId, stepOrder])
  @@map("journal_approval_steps")
}

// One approval or rejection action against a step. A step advances once its
// approval count reaches JournalApprovalStep.approvalsRequired.
model JournalEntryApproval {
  id         String       @id @default(cuid())
  entryId    String
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  stepOrder  Int
  approvedBy String
  note       String?
  createdAt  DateTime     @default(now())

  @@map("journal_entry_approvals")
}

// Fingerprint punches pulled from the ZKTeco device (or added manually).
// (deviceUserId, at) is unique so re-syncing never duplicates records.
model AttendanceLog {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  deviceUserId String
  at           DateTime
  source       String    @default("DEVICE") // DEVICE | MANUAL
  // Punch direction + how it was verified — parsed from the ATTLOG wire
  // format (Phase 4; nullable since rows pushed before this shipped never
  // had it, and a manual punch has no device verify-method).
  status       String? // IN | OUT | BREAK_OUT | BREAK_IN | OVERTIME_IN | OVERTIME_OUT
  verifyMethod String? // FINGERPRINT | CARD | PASSWORD | FACE | OTHER
  workCode     String?
  createdAt    DateTime  @default(now())

  @@unique([deviceUserId, at])
  @@index([employeeId, at])
  @@index([at])
  @@map("attendance_logs")
}

// A ZKTeco device configured to push attendance over the internet (ADMS/Cloud
// Server mode) instead of requiring a LAN-bound puller. The device's only
// identifier on the wire is its serial number (SN=...), and the protocol has
// no real authentication, so we allow-list serials here: an unregistered or
// deactivated device's pushes are acknowledged (so it doesn't retry-storm)
// but discarded — see IclockService.
model AttendanceDevice {
  id         String    @id @default(cuid())
  serial     String    @unique
  name       String?
  isActive   Boolean   @default(true)
  // Which branch this scanner is installed at (multi-outlet, Phase 3) —
  // optional, an unassigned device still works, it just won't be included in
  // outlet-filtered attendance reports.
  outletId   String?
  outlet     Outlet?   @relation(fields: [outletId], references: [id])
  lastSeenAt DateTime? // any handshake/heartbeat/push
  lastPushAt DateTime? // last successful ATTLOG push
  pushCount  Int       @default(0) // total punches accepted, lifetime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  enrolledUsers DeviceEnrolledUser[]

  @@map("attendance_devices")
}

// The device's own user-enrollment table, synced from OPERLOG pushes (the
// device already sends this — TransFlag position 2 was enabled from day
// one — nothing previously parsed it). Read-only reference only, never
// authoritative over Employee: lets an admin see "device PIN 7 = Ram
// Bahadur" while wiring up Employee.deviceUserId, nothing more.
model DeviceEnrolledUser {
  id           String           @id @default(cuid())
  deviceId     String
  device       AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pin          String
  name         String?
  card         String?
  privilege    String?
  lastSyncedAt DateTime         @default(now())

  @@unique([deviceId, pin])
  @@map("device_enrolled_users")
}

// ─────────────────────────────────────────────────────────────
// HRM (Phase 4) — employee documents, performance notes, leave, shift
// scheduling, payroll adjustments. Employee.dateOfBirth..designation above
// covers the personal-info half of the HR profile; these models cover the
// rest.
// ─────────────────────────────────────────────────────────────

model EmployeeDocument {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           String // CITIZENSHIP | PASSPORT | PAN | CONTRACT | CERTIFICATE | OTHER
  title          String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  // Link to an externally-hosted scan — same convention as MenuItem.imageUrl;
  // no file-upload/storage infrastructure exists in this app or is being
  // added for this.
  url            String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@map("employee_documents")
}

model PerformanceNote {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String // NOTE | WARNING | COMMENDATION
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@map("performance_notes")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                 String         @id @default(cuid())
  name               String
  isPaid             Boolean        @default(true)
  defaultDaysPerYear Int            @default(0)
  color              String?
  isActive           Boolean        @default(true)
  requests           LeaveRequest[]

  @@map("leave_types")
}

// Leave *balance* is deliberately not stored here — it's computed on read
// (sum of this employee's APPROVED days for the year, vs
// LeaveType.defaultDaysPerYear) — same "derive, don't duplicate" pattern
// used throughout this codebase (ingredient stock, the pre-real-ledger
// accounting books).
model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  days         Float // supports half-days
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@map("leave_requests")
}

model ShiftTemplate {
  id        String        @id @default(cuid())
  name      String // "Morning", "Evening"
  startTime String // "08:00" — 24h wall-clock, no date
  endTime   String // "16:00"
  outletId  String?
  outlet    Outlet?       @relation(fields: [outletId], references: [id])
  color     String?
  isActive  Boolean       @default(true)
  entries   RosterEntry[]

  @@map("shift_templates")
}

// The actual weekly work schedule — distinct from Shift above, which stays
// exactly as the "clocked in right now" toggle it always was.
model RosterEntry {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  outletId        String
  outlet          Outlet         @relation(fields: [outletId], references: [id])
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  date            DateTime // the scheduled calendar day (Nepal-day-keyed)
  startTime       String
  endTime         String
  notes           String?
  createdAt       DateTime       @default(now())

  @@unique([employeeId, date, startTime])
  @@index([date])
  @@index([outletId, date])
  @@map("roster_entries")
}

// Bonuses/deductions/advances layered onto the existing ÷26-days payroll
// base calc in AttendanceService.payroll() — not a replacement for it.
model PayrollAdjustment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String // "2026-08" — same month-key convention as payroll(month)
  type        String // BONUS | DEDUCTION | ADVANCE
  amountCents Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([employeeId, month])
  @@map("payroll_adjustments")
}

// ─────────────────────────────────────────────────────────────
// SAAS CONTROL PLANE (only meaningful in the platform/control DB)
// Each tenant restaurant gets its OWN PostgreSQL database created from this
// same schema; these tables track tenants, plans and subscription payments.
// ─────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Plan {
  id                String                @id @default(cuid())
  code              String                @unique // STARTER | PRO | ENTERPRISE
  name              String
  priceMonthlyCents Int
  priceYearlyCents  Int
  maxEmployees      Int                   @default(10)
  maxItems          Int                   @default(200)
  features          Json? // marketing bullet list
  isActive          Boolean               @default(true)
  tenants           Tenant[]
  payments          SubscriptionPayment[]
  createdAt         DateTime              @default(now())

  @@map("plans")
}

model Tenant {
  id          String                @id @default(cuid())
  slug        String                @unique // subdomain / x-tenant header value
  name        String
  dbName      String                @unique
  status      TenantStatus          @default(TRIAL)
  planId      String?
  plan        Plan?                 @relation(fields: [planId], references: [id])
  ownerName   String?
  ownerPhone  String?
  ownerEmail  String?
  trialEndsAt DateTime?
  paidUntil   DateTime?
  notes       String?
  payments    SubscriptionPayment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("tenants")
}

// Manual subscription payment gateway: cash at office or direct bank transfer,
// recorded + verified by the platform owner. Verification extends paidUntil.
model SubscriptionPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?    @relation(fields: [planId], references: [id])
  amountCents Int
  method      String // CASH | BANK_TRANSFER
  reference   String? // bank voucher / txn reference
  months      Int      @default(1)
  status      String   @default("VERIFIED") // PENDING | VERIFIED | REJECTED
  periodStart DateTime
  periodEnd   DateTime
  receivedBy  String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("subscription_payments")
}
